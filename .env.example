# Kopiera till .env och fyll i. .env checkas aldrig in.
IPO_DB_PATH=data/ipo.db
# Hämtning två gånger per dag (svensk tid)
IPO_FETCH_TIMES=07:05,16:05
# Starta schemaläggaren när webbappen startar (1/0)
IPO_SCHEDULER=1
# Identifierar appen mot källorna
IPO_USER_AGENT=ipo-bevakning/0.1 (privat, icke-kommersiellt bruk)
# Steg 3: push-notiser via ntfy.sh (ämnet fungerar som lösenord – välj ett långt slumpat namn)
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
